# Virtual Lab IRK Mobile - Environment Configuration
# Copy this file to .env and update the values

# ============================================
# AUTHENTICATION MODE
# ============================================
# Options: 'mock' | 'clerk'
# - 'mock': Uses mock data for development (default)
# - 'clerk': Uses Clerk authentication with Hono backend
EXPO_PUBLIC_AUTH_MODE=mock

# ============================================
# API CONFIGURATION
# ============================================
# For local development with physical device, use your computer's IP address
# Example: http://192.168.1.10:8000 (avoid localhost when using a phone)
# For emulator: http://10.0.2.2:8000 (Android) or http://localhost:8000 (iOS)
# If backend is deployed (e.g., DigitalOcean), set the cloud URL instead.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# ============================================
# CLERK CONFIGURATION (Required if AUTH_MODE=clerk)
# ============================================
# Get these from https://dashboard.clerk.com
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# ============================================
# SUPABASE CONFIGURATION (Optional - for direct Supabase usage)
# ============================================
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
